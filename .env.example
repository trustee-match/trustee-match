# Copy to .env.local. Everything is optional for the /demo route.

# Supabase (London region). Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude. Set a monthly spend limit on the Anthropic Console workspace.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_DISABLED=true   # rules-only matching (degraded mode)

# Email (Resend). Without a key, emails are logged as dry runs.
RESEND_API_KEY=
EMAIL_FROM="Trustee Match <hello@example.org>"

# Shared secret for the 5-minute cron hitting /api/cron.
CRON_SECRET=

# Shared secret for POST /api/admin/reset (scripts/reset-db.mjs) — wipes and reseeds all
# test data. Required to be set for the endpoint to work at all (unset = always 401).
ADMIN_RESET_SECRET=

# Site-wide password gate for the public preview deploy (not real auth — see
# planning/responsible-design-decisions.md, Security). Leave unset to disable the gate
# entirely (e.g. local dev).
PREVIEW_PASSWORD=
